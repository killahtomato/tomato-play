# ============================================================================
# HTTP/CURL Functions
# ============================================================================

tp_curl() {
    _response="$($curl_exe -sL -A "$agent" --max-time 15 $cipher_flag $_px_flag -w ' %{http_code}' "$@")" || {
        _curl_status=$?
        printf 'Connection error: could not fetch %s (curl exit %s)\n' "$1" "$_curl_status" >&2
        return 1
    }
    _http_code=${_response##* }
    _response=${_response% *}
    case "$_http_code" in
        2??) ;;
        *) printf 'Request failed: HTTP %s from %s\n' "$_http_code" "$1" >&2; return 1 ;;
    esac
    printf "%s" "$_response"
}

# Fetch only the final HTTP status for a reachability probe. Unlike tp_curl,
# HTTP error statuses are returned to the caller so it can apply source-aware
# policy (for example, a 403 may still work in mpv). Use the same selected
# curl binary, user agent, TLS settings, and configured proxy as provider calls.
tp_curl_status() {
    if [ -n "${TOMATOPLAY_PROXY:-}" ]; then
        _http_status="$("$curl_exe" -sL -A "$agent" --max-time 8 $cipher_flag \
            --proxy "$TOMATOPLAY_PROXY" -o /dev/null -w '%{http_code}' "$@" 2>/dev/null)" || return 1
    else
        _http_status="$("$curl_exe" -sL -A "$agent" --max-time 8 $cipher_flag \
            -o /dev/null -w '%{http_code}' "$@" 2>/dev/null)" || return 1
    fi
    printf '%s\n' "$_http_status"
}

