nineanime_m3u8() {
    _page="$(tp_curl "${nineanime_base}/watch/$1")" || return 1
    [ -z "$_page" ] && return 1
    _ep_href="$(printf "%s" "$_page" | grep -oE 'href="/watch/'"$1"'/ep-'"$2"'"' | head -n 1 | sed 's|href="||; s|"$||')"
    _ep_url="${nineanime_base}${_ep_href:-/watch/$1/ep-$2}"
    _page="$(tp_curl "$_ep_url")" || return 1
    [ -z "$_page" ] && return 1
    _ep_data="$(printf "%s" "$_page" | grep -oE 'data-id="[0-9]+"' | head -n 1 | sed 's|data-id="||; s|"||')"
    if [ -z "$_ep_data" ]; then
        printf "best >%s\n" "$_ep_url"
        return 0
    fi
    _embed_page="$(tp_curl "${nineanime_base}/ajax/v2/episode/sources?id=${_ep_data}")"
    _video_url="$(printf "%s" "$_embed_page" | sed -nE 's|.*"source_url":"([^"]+)".*|\1|p' | head -n 1)"
    if [ -z "$_video_url" ]; then
        printf "best >%s\n" "$_ep_url"
        return 0
    fi
    _video_page="$(tp_curl "$_video_url")"
    printf "%s" "$_video_page" | sed -nE "s|.*file: '([^']*)'.*label: '([^']*)'.*|\2 >\1|p" | sort -g -r
}

# ============================================================================
# Provider: anime-planet.com
# ============================================================================

animeplanet_base="https://www.anime-planet.com"

animeplanet_search() {
    _page="$(tp_curl "${animeplanet_base}/anime/all?name=$(printf "%s" "$1" | sed 's| |+|g')")" || return 1
    [ -z "$_page" ] && die "Connection error: no response from anime-planet.com"
    printf "%s" "$_page" | awk '
        /href="\/anime\/[a-z0-9-]+"/ {
            line=$0; sub(/^.*href="\/anime\//, "", line); sub(/".*/, "", line); slug=line
        }
        /<img[^>]*alt="/ && slug!="" {
            line=$0; sub(/^.*alt="/, "", line); sub(/".*/, "", line); print slug "\t" line; slug=""
        }
    ' | head -n 20
}

animeplanet_episodes() {
    _page="$(tp_curl "${animeplanet_base}/anime/$1")" || return 1
    [ -z "$_page" ] && die "Connection error: no response from anime-planet.com"
    printf "%s" "$_page" | sed -nE 's|.*href="[^"]*episode-([0-9]+)".*|\1\t\1\tEpisode \1|p' | sort -n
}

animeplanet_m3u8() {
    # anime-planet provides legal streaming links, not direct video
    _page="$(tp_curl "${animeplanet_base}/anime/$1")" || return 1
    [ -z "$_page" ] && return 1
    printf "Legal streaming available at: https://www.anime-planet.com/anime/%s\n" "$1"
