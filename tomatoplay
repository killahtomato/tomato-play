# ============================================================================
# AniList scrobbling: after a play, quietly mark the episode as watched on
# AniList so your list stays in sync across devices. Opt-in via
# TOMATOPLAY_ANILIST_TOKEN (from anilist.co settings -> API). Runs detached so
# playback never waits on it; failures are silent.
# ============================================================================

_json_str() {
    printf '%s' "$1" | sed -e 's|\\|\\\\|g' -e 's|"|\\"|g'
}

anilist_scrobble() {
    [ -n "${TOMATOPLAY_ANILIST_TOKEN:-}" ] || return 0
    _as_title="$1"
    _as_ep="$2"
    printf "%s" "$_as_ep" | grep -qE '^[1-9][0-9]*$' || return 0
    _as_id="$(curl -sS -m 12 -X POST -H "Authorization: Bearer ${TOMATOPLAY_ANILIST_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"query\":\"query(\\\$q:String){Media(search:\\\$q,type:ANIME){id}}\",\"variables\":{\"q\":\"$(_json_str "$_as_title")\"}}" \
        "https://graphql.anilist.co" | grep -oE '"id":[0-9]+' | head -n 1 | cut -d: -f2)"
    [ -n "$_as_id" ] || return 0
    _as_prog="$(curl -sS -m 12 -X POST -H "Authorization: Bearer ${TOMATOPLAY_ANILIST_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"query\":\"query(\\\$id:Int){Media(id:\\\$id){mediaListEntry{progress}}}\",\"variables\":{\"id\":$_as_id}}" \
        "https://graphql.anilist.co" | grep -oE '"progress":[0-9]+' | head -n 1 | cut -d: -f2)"
    [ -n "$_as_prog" ] || _as_prog=0
    [ "$_as_ep" -le "$_as_prog" ] && return 0
    curl -sS -m 12 -X POST -H "Authorization: Bearer ${TOMATOPLAY_ANILIST_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"query\":\"mutation(\\\$id:Int,\\\$prog:Int){SaveMediaListEntry(mediaId:\\\$id,progress:\\\$prog){id}}\",\"variables\":{\"id\":$_as_id,\"prog\":$_as_ep}}" \
        "https://graphql.anilist.co" >/dev/null 2>&1
}

# Render a torrent row for the picker: "[torrent]" first (colored for fzf),
# then the title, then the peer count "[peers: N]" (green when seeders exist,
# red when dead). Seeders info stays out of field 1 so selection parsing is
# unaffected, and resolve_title strips colors + markers for clean titles.

render_torrent_line() {
    _rt_id="$(printf "%s" "$1" | cut -f 1)"
    _rt_t="$(printf "%s" "$1" | cut -f 2)"
    _rt_leech="$(printf "%s" "$1" | cut -f 4)"
    if [ "$menu_program" = "fzf" ]; then
        # printf's \033 is a real ESC; double quotes would keep it literal.
        _rt_m="$(printf '\033[1;33m[torrent]\033[0m')"
        if [ "${2:-0}" -gt 0 ] 2>/dev/null; then
            _rt_p="$(printf '\033[1;32m[seeds: %s]\033[0m' "${2:-0}")"
        else
            _rt_p="$(printf '\033[1;31m[seeds: %s]\033[0m' "${2:-0}")"
        fi
        if [ -n "$_rt_leech" ] && printf "%s" "$_rt_leech" | grep -qE '^[0-9]+$'; then
            _rt_p="$_rt_p$(printf ' \033[2m[leech: %s]\033[0m' "$_rt_leech")"
        fi
    else
        _rt_m="[torrent]"
        _rt_p="[seeds: ${2:-0}]"
        [ -n "$_rt_leech" ] && printf "%s" "$_rt_leech" | grep -qE '^[0-9]+$' && _rt_p="$_rt_p [leech: $_rt_leech]"
    fi
    printf "%s\t%s %s %s\n" "$_rt_id" "$_rt_m" "$_rt_t" "$_rt_p"
}


# ============================================================================
# Cache: search + playability probes. Wiped when >$cache_ttl days old so it
# never grows unbounded; per-entry freshness is enforced by cache_read.
# ============================================================================
cache_dir="${TOMATOPLAY_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/tomato-play}"
cache_ttl="${TOMATOPLAY_CACHE_TTL:-7}"
cache_init() {
    [ -n "$cache_dir" ] || return 0
    [ -d "$cache_dir" ] || mkdir -p "$cache_dir"
    if find "$cache_dir" -type f -mtime "+$cache_ttl" | grep -q .; then
        rm -rf "$cache_dir"
        mkdir -p "$cache_dir"
    fi
}

# One-line cache: if a fresh slot exists for $1, print it and return 0. Caller
# prints its own body on a miss after calling cache_write.
cache_read() {
    [ -n "$cache_dir" ] || return 1
    [ -f "$cache_dir/$1" ] || return 1
    if find "$cache_dir/$1" -mmin "-${2:-900}" | grep -q .; then
        cat "$cache_dir/$1"
        return 0
    fi
    rm -f "$cache_dir/$1"
    return 1
}
cache_write() {
    [ -n "$cache_dir" ] || return 0
    printf "%s\n" "$2" >"$cache_dir/$1" 2>/dev/null
}

_cpe_key() {
    _ck=""
    for _ck_a in "$@"; do
        _ck="$_ck\t$_ck_a"
    done
    printf "%s" "$_ck" | cksum | cut -d " " -f 1
}

# List playable media for local playback: a single file as-is, or every video
# file under a folder (paths + names relative to that folder so menus stay
# readable). External subtitle files are left alone — players pick them up by
# matching the video's basename.
local_media_list() {
    if [ -f "$1" ]; then
        printf "%s\t%s\n" "$1" "$(basename "$1")"
        return 0
    fi
    _lm_prefix="$1/"
    find -L "$1" -type f \( -iname '*.mkv' -o -iname '*.mp4' -o -iname '*.webm' -o \
        -iname '*.avi' -o -iname '*.mov' -o -iname '*.m4v' -o -iname '*.ts' -o \
        -iname '*.flv' -o -iname '*.wmv' -o -iname '*.mpg' -o -iname '*.mpeg' -o \
        -iname '*.3gp' -o -iname '*.ogv' -o -iname '*.mts' -o -iname '*.vob' \) \
        2>/dev/null | sort | while IFS= read -r _lf; do
        printf "%s\t%s\n" "$_lf" "${_lf#"$_lm_prefix"}"
    done
}

# --lucky-tomato: shuffle the trending list and stop at the first show that
# actually has a playable stream.
pick_lucky_show() {
    _lucky_cands="$(provider_trending aniwatch)" || exit 1
    [ -z "$_lucky_cands" ] && die "The vine's bare right now — try again in a bit."
    _lucky_file="$(mktemp)" || return 1
    printf "%s\n" "$_lucky_cands" | sort -R | head -n 12 >"$_lucky_file"
    while IFS= read -r _lucky_line <&3; do
        [ -z "$_lucky_line" ] && continue
        source=aniwatch
        anime_id="$(printf "%s" "$_lucky_line" | cut -f 1)"
        anime_title="$(printf "%s" "$_lucky_line" | cut -f 2)"
        episode_maps="$(provider_episodes aniwatch "$anime_id" 2>/dev/null)"
        _first_key="$(printf '%s\n' "$episode_maps" | cut -f 1 | head -n 1)"
        ep_no="$(printf '%s\n' "$episode_maps" | cut -f 2 | head -n 1)"
        if [ -n "$_first_key" ] && provider_m3u8 aniwatch "$anime_id" "$_first_key" sub 2>/dev/null | _probe_playable; then
            ep_list="$(printf '%s' "$episode_maps" | cut -f 2)"
            rm -f "$_lucky_file"
            info "Plucked a ripe one off the vine: $anime_title :3"
            return 0
        fi
    done 3<"$_lucky_file"
    rm -f "$_lucky_file"
    die "Everything on the vine's unripe today — try again later."
}

# Probe each source end-to-end (search -> episodes -> stream link) and report
# what actually works right now. Results ride the normal cache.
source_health() {
    printf "\n    \033[1;32mProbing the vine — how ripe are the sources?\033[0m\n"
    printf "    %-14s %-9s %s\n" "source" "search" "playable"
for _p in aniwatch gogoanime 9anime anidb animeplanet anisearch youtube bilibili miruro animegg hianime nyaa tpb; do
        _search="no"
        _play="-"
        _r="$(provider_search "$_p" "naruto" 2>/dev/null | head -n 1)"
        if [ -n "$_r" ]; then
            _search="yes"
            _id="$(printf "%s" "$_r" | cut -f 1)"
            _first_ep="$(provider_episodes "$_p" "$_id" 2>/dev/null | head -n 1 | cut -f 1)"
            if [ -n "$_first_ep" ]; then
                _ml="$(provider_m3u8 "$_p" "$_id" "$_first_ep" "sub" 2>/dev/null)"
                if [ -n "$_ml" ]; then
                    if printf "%s\n" "$_ml" | _probe_playable; then
                        _play="yes"
                    else
                        _play="stale"
                    fi
                fi
            else
                _play="no eps"
            fi
        fi
        printf "    %-14s %-9s %s\n" "$_p" "$_search" "$_play"
    done
    printf "\n    Repeat runs are near-instant thanks to the cache.\n\n"
}

# ============================================================================
# Setup
# ============================================================================

ciphers='ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'
tls13_ciphers='TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256'
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# Global proxy: applied to every provider request. Handy for geo-locked
# sources (bilibili) — or just use a VPN, which curl follows anyway.
_px_flag=""
[ -n "${TOMATOPLAY_PROXY:-}" ] && _px_flag="-x $TOMATOPLAY_PROXY"

# ============================================================================
# Config file: ~/.config/tomato-play/tomato-playrc
# Optional KEY=VALUE defaults read before the environment. Precedence is
# CLI flags > environment > config file, so a config entry only applies when
# the matching TOMATOPLAY_* env var isn't already set.
# ============================================================================
config_dir="${TOMATOPLAY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tomato-play}"
config_file="${TOMATOPLAY_CONFIG:-$config_dir/tomato-playrc}"
if [ -f "$config_file" ] && [ -r "$config_file" ]; then
    while IFS='=' read -r _cf_key _cf_val || [ -n "$_cf_key" ]; do
        _cf_key=$(printf "%s" "$_cf_key" | tr -d '[:space:]')
        case "$_cf_key" in
            '' | '#'*) continue ;;
        esac
        case "$_cf_key" in
            mode) [ -z "${TOMATOPLAY_MODE:-}" ] && TOMATOPLAY_MODE="$_cf_val" ;;
            quality) [ -z "${TOMATOPLAY_QUALITY:-}" ] && TOMATOPLAY_QUALITY="$_cf_val" ;;
            player) [ -z "${TOMATOPLAY_PLAYER:-}" ] && TOMATOPLAY_PLAYER="$_cf_val" ;;
            menu) [ -z "${TOMATOPLAY_MENU:-}" ] && TOMATOPLAY_MENU="$_cf_val" ;;
            source) [ -z "${TOMATOPLAY_DEFAULT_SOURCE:-}" ] && TOMATOPLAY_DEFAULT_SOURCE="$_cf_val" ;;
            download_dir) [ -z "${TOMATOPLAY_DOWNLOAD_DIR:-}" ] && TOMATOPLAY_DOWNLOAD_DIR="$_cf_val" ;;
            log) [ -z "${TOMATOPLAY_LOG:-}" ] && TOMATOPLAY_LOG="$_cf_val" ;;
            anilist_token) [ -z "${TOMATOPLAY_ANILIST_TOKEN:-}" ] && TOMATOPLAY_ANILIST_TOKEN="$_cf_val" ;;
            cache_ttl) [ -z "${TOMATOPLAY_CACHE_TTL:-}" ] && TOMATOPLAY_CACHE_TTL="$_cf_val" ;;
            miruro_api) [ -z "${TOMATOPLAY_MIRURO_API:-}" ] && TOMATOPLAY_MIRURO_API="$_cf_val" ;;
            resume_back) [ -z "${TOMATOPLAY_RESUME_BACK:-}" ] && TOMATOPLAY_RESUME_BACK="$_cf_val" ;;
        esac
    done <"$config_file"
else
    # First run: plant a commented starter so defaults are easy to find.
    mkdir -p "$config_dir"
    cat >"$config_file" <<'EOF'
# Tomato Play config - KEY=VALUE lines mapping to TOMATOPLAY_* environment
# variables. Precedence is CLI flags > environment > this file.
#
# mode=sub     # sub or dub
# quality=best # mpv-style quality string
# player=mpv   # player binary or flatpak path
# menu=fzf     # fzf, rofi, or dmenu
# source=all   # all, anidb, aniwatch, gogoanime, 9anime, animeplanet, anisearch, youtube, bilibili, miruro, animegg, hianime, nyaa, tpb
# miruro_api=https://api.hiyori.tv # community Miruro API endpoint
# download_dir=.
# log=1        # 1 to log episodes to the system journal
# cache_ttl=7  # wipe the cache once older than this many days
# resume_back=10 # resume mid-episode, replaying this many seconds back
# anilist_token= # AniList API token -> scrobble watched episodes
EOF
fi

mode="${TOMATOPLAY_MODE:-sub}"
if [ -n "$TOMATOPLAY_MODE" ]; then mode_set=1; else mode_set=0; fi
case "$mode" in dub) mode="dub" ;; *) mode="sub" ;; esac
download_dir="${TOMATOPLAY_DOWNLOAD_DIR:-.}"
log_episode="${TOMATOPLAY_LOG:-1}"
quality="${TOMATOPLAY_QUALITY:-best}"
source="${TOMATOPLAY_DEFAULT_SOURCE:-all}"

curl_exe=$(dep_ch_failover "curl_firefox135,curl_chrome136,curl_chrome116,curl_ff117,curl") || die "Program curl not found"

case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*)
        cipher_flag="--ciphers $ciphers --tls13-ciphers $tls13_ciphers"
        player_function="${TOMATOPLAY_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}" || die 'No player found'
        ;;
    *ndroid*) player_function="${TOMATOPLAY_PLAYER:-android_mpv}" ;;
    *MINGW* | *WSL2*) player_function="${TOMATOPLAY_PLAYER:-mpv.exe}" ;;
    *) player_function="${TOMATOPLAY_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}" || die 'No player found' ;;
esac

player_extra_flags="${TOMATOPLAY_PLAYER_FLAGS:-""}"
no_detach="${TOMATOPLAY_NO_DETACH:-0}"
exit_after_play="${TOMATOPLAY_EXIT_AFTER_PLAY:-0}"
preview_len="${TOMATOPLAY_PREVIEW_SECS:-60}"
resume_back="${TOMATOPLAY_RESUME_BACK:-10}"
menu_program="${TOMATOPLAY_MENU:-fzf}"
menu_extra_flags="${TOMATOPLAY_MENU_FLAGS:-""}"
branch="${TOMATOPLAY_BRANCH:-main}"
_menu_explicit=0
[ -n "$TOMATOPLAY_MENU" ] && _menu_explicit=1

hist_dir="${TOMATOPLAY_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tomato-play}"
resume_dir="$hist_dir/resume"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/tp-hsts"
[ ! -f "$histfile" ] && : >"$histfile"

cache_init

# ============================================================================
# Argument Parsing
# ============================================================================

query=""
auto_next=0
preview=0
cont_run=0
cast_dest=""
room_dir=""
room_role=""
local_path=""
source_flag=0
cache_info_check=0
while [ $# -gt 0 ]; do
    case "$1" in
        -s | --source)
            [ $# -lt 2 ] && die "missing argument!"
            source="$2"
            source_flag=1
            shift
            ;;
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) source=history ;;
        -T | --trending) source=trending ;;
        -L | --lucky-tomato) source=lucky ;;
        -f | --file)
            source=files
            if [ $# -gt 1 ] && ! printf "%s" "$2" | grep -q '^-'; then
                local_path="$2"
                shift
            fi
            ;;
        -d | --download)
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            rm -rf -- "$resume_dir"
            exit 0
            ;;
        -H | --history)
            history_view "$histfile"
            exit 0
            ;;
        --stats)
            stats_check=1
            ;;
        --sources)
            sources_check=1
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t tomatoplay ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        -a | --audio)
            [ $# -lt 2 ] && die "missing argument!"
            case "$2" in dub) mode="dub" ;; *) mode="sub" ;; esac
            mode_set=1
            shift
            ;;
        --dub) mode="dub"; mode_set=1 ;;
        --no-detach) no_detach=1 ;;
        --cast) cast_dest="--chromecast" ;;
        --dlna) cast_dest="--dlna" ;;
        --room)
            room_role="host"
            room_dir="${2:-}"
            [ -n "$room_dir" ] && shift
            ;;
        --join)
            room_role="guest"
            room_dir="${2:-}"
            [ -n "$room_dir" ] && shift
            ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        -n | --next) auto_next=1 && no_detach=1 ;;
        --preview) preview=1 && no_detach=1 ;;
        --cache-info) cache_info_check=1 ;;
        --clear-cache) [ -n "$cache_dir" ] && rm -rf -- "$cache_dir"; exit 0 ;;
        --no-cache) cache_dir="" ;;
        --rofi) menu_program=rofi; _menu_explicit=1 ;;
        --dmenu) menu_program=dmenu; _menu_explicit=1 ;;
        -U | --update)
            dep_ch "patch"
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

# A positional argument that's an existing file or folder means "play this
# locally" — nicer than always requiring --file (unless a source was named).
if [ "$source_flag" != 1 ] && [ -n "$query" ]; then
    _qpath=$(printf "%s" "$query" | tr '+' ' ')
    if [ -e "$_qpath" ]; then
        source=files
        local_path="$_qpath"
        query=""
    fi
fi

# Watch room, guest side: follow whatever the host is playing in a shared
# folder (or the same box). The room scripts + state live in room_dir.
if [ "$room_role" = "guest" ]; then
    room_join_prepare
    _room_join_status=$?
    case "$_room_join_status" in
        0) ;;
        1) die "Couldn't prepare the room directory." ;;
        2) die "No room session yet — start the host first (tp --room)." ;;
        3) die "Room file '$local_path' isn't visible here — use a shared folder/NAS." ;;
    esac
    source=files
fi

# Headless runs (non-tty) fall back to a GUI picker so menus still work while
# piping, but never override an explicit --rofi/--dmenu/TOMATOPLAY_MENU choice.
if [ ! -t 0 ] && [ "$_menu_explicit" != 1 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi

[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

# ============================================================================
# Dependency Check
# ============================================================================

trap 'cleanup; exit 1' INT HUP TERM

if [ "$sources_check" = 1 ]; then
    [ -t 1 ] && banner
    source_health
    exit 0
fi

if [ "$stats_check" = 1 ]; then
    [ -t 1 ] && banner
    garden_stats "$histfile"
    exit 0
fi

if [ "$cache_info_check" = 1 ]; then
    [ -t 1 ] && banner
    if [ -n "$cache_dir" ] && [ -d "$cache_dir" ]; then
        _csize=$(du -sh "$cache_dir" 2>/dev/null | cut -f 1)
        _cfiles=$(find "$cache_dir" -type f 2>/dev/null | wc -l | tr -d '[:space:]')
        printf "    Cache dir: %s\n    Entries: %s\n    Size: %s\n" "$cache_dir" "$_cfiles" "$_csize"
    else
        printf "    Cache is empty or disabled (--no-cache).\n"
    fi
    exit 0
fi

# Bare interactive invocations get a home menu instead of the raw search
# prompt, with the mascot banner and tagline shown right above it.
if [ -t 0 ] && [ -t 1 ] && [ -z "$query" ] &&
   ! printf "%s" "$source" | grep -qxE 'history|trending|lucky|files'; then
    banner
    home_menu || die "Couldn't read a menu choice."
    case "$_home_action" in
        search) source="${TOMATOPLAY_DEFAULT_SOURCE:-all}" ;;
        continue) source=history ;;
        history) history_view "$histfile"; exit 0 ;;
        trending) source=trending ;;
        lucky) source=lucky ;;
        files) source=files ;;
        quit) exit 0 ;;
        *) die "Invalid home menu action." ;;
    esac
else
    [ -t 1 ] && banner
fi

info "Checking dependencies, one sec"
dep_ch "sed"
dep_ch "grep"
dep_ch "$menu_program"

case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *flatpak*mpv*) dep_ch "flatpak" ;;
    *) dep_ch "$player_function" ;;
esac

# ============================================================================
# Main Logic
# ============================================================================

case "$source" in
    history)
        anime_list=$(while read -r _history_ep _history_id _history_title; do
            process_hist_entry "$resume_dir" "$_history_ep" "$_history_id" "$_history_title" &
        done <"$histfile")
        wait
        [ -z "$anime_list" ] && die "You're all caught up! Nothing unwatched in your history, time to pick another show?"
        source=all
        resolve_title "$anime_list" "$index" "$source" "$menu_extra_flags" "$menu_program"
        anime_title="$(printf "%s" "$anime_title" | sed 's| - episode.*||')"
        ep_no=$(printf "%s" "$anime_list" | grep "^${real_source}:${anime_id}	" | sed -nE 's/.*- episode (.+)$/\1/p')
        # Continuing skips the audio & preview questions: reuse the audio track
        # used last time (if we remember it) and jump straight in.
        cont_run=1
        _mode_key=$(printf "mode_%s" "$anime_id" | tr -c '[:alnum:]' '_')
        if [ -f "$resume_dir/$_mode_key" ]; then
            _saved_mode=$(cat "$resume_dir/$_mode_key")
            case "$_saved_mode" in dub) mode="dub" ;; *) mode="sub" ;; esac
            info "Audio: $mode (from last time)"
        fi
        mode_set=1
        resolve_episodes "$source" "$anime_id" "$ep_no" "$menu_multi_flag" "$menu_extra_flags" "$menu_program"
        ;;
    trending)
        anime_list="$(provider_trending aniwatch)"
        [ -z "$anime_list" ] && die "The vine's bare right now — try again in a bit."
        source=aniwatch
        anime_list="$(printf "%s\n" "$anime_list" | filter_entries "$source")"
        [ -z "$anime_list" ] && die "No playable picks on the vine right now."
        resolve_title "$anime_list" "$index" "$source" "$menu_extra_flags" "$menu_program"
        resolve_episodes "$source" "$anime_id" "$ep_no" "$menu_multi_flag" "$menu_extra_flags" "$menu_program"
        ;;
    lucky)
        pick_lucky_show
        ;;
    files)
        if [ -z "$local_path" ]; then
            if [ -t 0 ]; then
                printf "\33[2K\r\033[1;36mLocal file (or folder): \033[0m" && read -r local_path || exit 1
            fi
            [ -z "$local_path" ] && die "No local file selected, sorry!"
        fi
        local_path=$(printf "%s" "$local_path" | sed "s|^~|$HOME|")
        [ -e "$local_path" ] || die "No such file or folder: $local_path"
        local_files="$(local_media_list "$local_path")"
        [ -z "$local_files" ] && die "No playable media in that folder, sorry!"
        _choice="$(printf "%s\n" "$local_files" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Pick a local file: " "" "$menu_extra_flags" "$menu_program")"
        [ -z "$_choice" ] && die "That pick didn't work out — try again!"
        video_link="$(printf "%s" "$_choice" | cut -f 1)"
        anime_title="$(printf "%s" "$_choice" | cut -f 2)"
        anime_id="$(printf "%s" "$video_link" | tr -c '[:alnum:]' '_')"
        ep_no="1"
        episode_maps="1"
        ep_list="1"
        ;;
    *)
        while [ -z "$query" ]; do
            printf "\33[2K\r\033[1;36mSearch: \033[0m" && read -r query || exit 1
        done

        query=$(printf "%s" "$query" | tr -s ' ')

        anime_list=$(fuzzy_search "$source" "$query") || exit 1
        if [ -z "$anime_list" ]; then
            if [ "$source" = "bilibili" ]; then
                die "bilibili came up empty for that — it rate-limits search aggressively and often misses English titles. Try the Chinese name, wait a few minutes, or use -s aniwatch."
            fi
            die "Hmm, nothing found for that — double-check the spelling maybe?"
        fi
        # Only offer series that actually have an episode list (anything else
        # would fail later with an invalid episode selection).
        anime_list=$(printf "%s\n" "$anime_list" | filter_entries "$source")
        if [ -z "$anime_list" ]; then
            if [ "$source" = "bilibili" ]; then
                die "bilibili had candidates but none could be verified playable — likely geo-locked. Enable a VPN/proxy (TOMATOPLAY_PROXY) for bilibili, or use -s aniwatch."
            fi
            die "Hmm, nothing found for that — double-check the spelling maybe?"
        fi
        resolve_title "$anime_list" "$index" "$source" "$menu_extra_flags" "$menu_program"
        resolve_episodes "$source" "$anime_id" "$ep_no" "$menu_multi_flag" "$menu_extra_flags" "$menu_program"
        ;;
esac

# If the series has an English dub, let the user pick the audio track.
if [ "$source" = "aniwatch" ] && [ "$mode_set" = "0" ] && [ -t 1 ]; then
    if printf "%s" "$ep_no" | grep -qE '^[0-9]+$'; then
        _modes="$(provider_audio_modes "$source" "$anime_id" "$ep_no" 2>/dev/null || true)"
        if printf "%s" "$_modes" | grep -qx "dub"; then
            _audio_menu=""
            printf "%s" "$_modes" | grep -qx "sub" && _audio_menu="${_audio_menu}sub\\tSubtitled (Japanese)\\n"
            _audio_menu="${_audio_menu}dub\\tEnglish Dub\\n"
            _audio_choice="$(printf "%b" "$_audio_menu" | menu "$menu_program" "Audio: " "" "$menu_extra_flags")"
            case "$_audio_choice" in
                *dub*) mode="dub" ;;
                *) mode="sub" ;;
            esac
            info "Audio: $mode"
            mode_set=1
        fi
    fi
fi

# After the episode (and audio) are picked, let mpv users poke at the first
# few seconds before committing. Esc to skip the peek and dive straight in.
if [ "$preview" != 1 ] && [ "$cont_run" != 1 ] && [ "$source" != "files" ] && [ -t 0 ] && [ -t 1 ] &&
   printf "%s" "$ep_no" | grep -qE '^[0-9]+$' &&
   printf "%s" "$player_function" | grep -q '[mM]pv'; then
    _peek_choice=$(printf "%b" "preview\\tPeek at the first ${preview_len}s\\ncontinue\\tDive straight in" | menu "$menu_program" "Episode $ep_no of $anime_title — " "" "$menu_extra_flags")
    case "$_peek_choice" in
        *preview*) preview=1 ;;
        *) : ;;
    esac
fi

tput cuu1 && tput el
tput sc

play
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

# Local plays are one-shot: no episode loop, just fire and (optionally) keep
# the player attached until it finishes.
[ "$source" = "files" ] && exit 0
[ "$source" = "nyaa" ] && exit 0
[ "$source" = "tpb" ] && exit 0

while cmd=$(printf "next\nreplay\nprevious\nselect\nchange_audio\nchange_quality\nquit" | nth "Now showing episode $ep_no of $anime_title — enjoy! ... " "" "$menu_extra_flags" "$menu_program"); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) video_link="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no="$(select_episode_numbers "$episode_maps" "$menu_multi_flag" "$menu_extra_flags" "$menu_program")" ;;
        change_audio)
            case "$mode" in dub) mode="sub" ;; *) mode="dub" ;; esac
            info "Audio: $mode"
            video_link=""
            ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu "$menu_program" "Select Quality: " "" "$menu_extra_flags" | cut -d ">" -f 1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

