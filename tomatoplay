# ============================================================================
# Provider Selection
# ============================================================================

provider_search() {
    case "$1" in
        anidb) anidb_search "$2" ;;
        aniwatch) aniwatch_search "$2" ;;
        gogoanime) gogoanime_search "$2" ;;
        9anime) nineanime_search "$2" ;;
        animeplanet) animeplanet_search "$2" ;;
        anisearch) anisearch_search "$2" ;;
        youtube) youtube_search "$2" ;;
        all)
            # Search all providers and combine results (prefixed with provider),
            # streamable sources first so the default selection is playable.
            _results=""
            for _provider in aniwatch gogoanime 9anime anidb youtube animeplanet anisearch; do
                [ "$_provider" = "youtube" ] && continue
                _provider_results="$("${_provider}_search" "$2" 2>/dev/null)"
                if [ -n "$_provider_results" ]; then
                    _provider_results="$(printf "%s" "$_provider_results" | sed "s|^|${_provider}:|")"
                    _results="$(printf "%s\n%s" "$_results" "$_provider_results")"
                fi
            done
            printf "%s" "$_results" | grep -v '^$'
            ;;
        *) die "Unknown provider: $1" ;;
    esac
}

# Generate progressively looser search queries (best first) so a typo or extra
# words in the user's input can still find the right show.
search_relax() {
    _sq="$1"
    printf "%s\n" "$_sq"
    _snorm="$(printf "%s" "$_sq" | sed 's|[^A-Za-z0-9 ]| |g; s|[[:space:]][[:space:]]*| |g; s|^ ||; s| $||')"
    [ -n "$_snorm" ] && [ "$_snorm" != "$_sq" ] && printf "%s\n" "$_snorm"
    _sstop="$(printf "%s" "$_snorm" | awk '{ for (i = 1; i <= NF; i++) { w = $i; if (w !~ /^(the|a|an|of|to|and|movie|movies|full|sub|dub|season|part|ep|episode|show|series)$/) { if (l) printf " "; printf "%s", w; l = 1 } } }')"
    [ -n "$_sstop" ] && [ "$_sstop" != "$_snorm" ] && printf "%s\n" "$_sstop"
    _sdw="$(printf "%s" "$_sstop" | sed -E 's|[[:space:]][^[:space:]]*$||')"
    [ -n "$_sdw" ] && [ "$_sdw" != "$_sstop" ] && printf "%s\n" "$_sdw"
    _sfw="$(printf "%s" "$_sstop" | sed -E 's|[[:space:]].*$||')"
    [ -n "$_sfw" ] && [ "$_sfw" != "$_sstop" ] && printf "%s\n" "$_sfw"
    for _fword in $_sstop; do
        case "${#_fword}" in
            0|1|2|3|4) continue ;;
        esac
        printf "%s\n" "$_fword"
        printf "%s\n" "$(printf "%s" "$_fword" | cut -c1-4)"
    done
}

# Order a provider's search results so the title closest to the user's query
# floats to the top (word overlap + exact phrase + shared prefix, minus a length
# penalty for tacked-on extras like "Season 3" or "Dub").
fuzzy_rank() {
    awk -v query="$1" '
        function norm(s) {
            gsub(/[^A-Za-z0-9 ]/, " ", s)
            gsub(/[ ]+/, " ", s)
            return tolower(s)
        }
        BEGIN { q = norm(query); nq = split(q, qw, " ") }
        {
            title = $0
            sub(/^[^\t]*\t/, "", title)
            t = norm(title)
            score = 0
            nt = split(t, tw, " ")
            for (i = 1; i <= nq; i++) {
                if (qw[i] == "") continue
                best = 0
                for (j = 1; j <= nt; j++) {
                    if (tw[j] == qw[i]) {
                        best = 6 + length(qw[i])
                    } else if (length(qw[i]) >= 3 && length(tw[j]) >= 3) {
                        if (substr(tw[j], 1, length(qw[i])) == qw[i]) v = 3 + length(qw[i])
                        else if (substr(qw[i], 1, length(tw[j])) == tw[j]) v = 3 + length(tw[j])
                        else v = 0
                        if (v > best) best = v
                    }
                }
                score += best
            }
            if (index(t, q)) score += 6
            cl = (length(q) < length(t)) ? length(q) : length(t)
            for (p = 1; p <= cl && substr(q, p, 1) == substr(t, p, 1); p++) score += 1
            dl = length(t) - length(q); if (dl < 0) dl = -dl
            if (dl > 8) dl = 8
            printf "%d\t%s\n", score - dl, $0
        }
    '
}

# Fuzzier search: try successively looser queries, merge unique results, and
# rank by closeness so the best match lands on top.
fuzzy_search() {
    _fs_src="$1"
    _fs_query="$2"
    _fs_tried=""
    _fs_found=""
    _fs_cands="$(mktemp)" || return 1
    search_relax "$_fs_query" >"$_fs_cands"
    while IFS= read -r _fs_cand <&3; do
        [ -n "$_fs_cand" ] || continue
        if printf "%s\n" "$_fs_tried" | grep -qxF "$_fs_cand"; then continue; fi
        _fs_tried="$(printf "%s\n%s" "$_fs_tried" "$_fs_cand")"
        _fs_r="$(provider_search "$_fs_src" "$_fs_cand" 2>/dev/null)"
        if [ -n "$_fs_r" ]; then
            _fs_found="$(printf "%s\n%s" "$_fs_found" "$_fs_r" | grep -v '^$')"
            break
        fi
    done 3<"$_fs_cands"
    rm -f "$_fs_cands"
    [ -z "$_fs_found" ] && return 0
    printf "%s\n" "$_fs_found" | grep -v '^$' | sort -u | fuzzy_rank "$_fs_query" |
        sort -t "$(printf '\t')" -k1,1 -nr | cut -f 2- | grep -v '^$' | head -n 10
}

provider_episodes() {
    _key="$(_cpe_key "epi" "$1" "$2")"
    if cache_read "$_key" 1440; then
        return 0
    fi
    case "$1" in
        anidb) _epi_out="$(anidb_episodes "$2" 2>/dev/null)" ;;
        aniwatch) _epi_out="$(aniwatch_episodes "$2" 2>/dev/null)" ;;
        gogoanime) _epi_out="$(gogoanime_episodes "$2" 2>/dev/null)" ;;
        9anime) _epi_out="$(nineanime_episodes "$2" 2>/dev/null)" ;;
        animeplanet) _epi_out="$(animeplanet_episodes "$2" 2>/dev/null)" ;;
        anisearch) _epi_out="$(anisearch_episodes "$2" 2>/dev/null)" ;;
        youtube) _epi_out="$(youtube_episodes "$2" 2>/dev/null)" ;;
        *) die "Unknown provider: $1" ;;
    esac
    [ -z "$_epi_out" ] && return 1
    cache_write "$_key" "$_epi_out"
    printf "%s\n" "$_epi_out"
}

# ============================================================================
# Cache: search + playability probes. Wiped when >$cache_ttl days old so it
# never grows unbounded; per-entry freshness is enforced by cache_read.
# ============================================================================
cache_dir="${TOMATOPLAY_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/tomato-play}"
cache_ttl="${TOMATOPLAY_CACHE_TTL:-7}"
cache_init() {
    [ -d "$cache_dir" ] || mkdir -p "$cache_dir"
    if find "$cache_dir" -type f -mtime "+$cache_ttl" | grep -q .; then
        rm -rf "$cache_dir"
        mkdir -p "$cache_dir"
    fi
}

# One-line cache: if a fresh slot exists for $1, print it and return 0. Caller
# prints its own body on a miss after calling cache_write.
cache_read() {
    [ -f "$cache_dir/$1" ] || return 1
    if find "$cache_dir/$1" -mmin "-${2:-900}" | grep -q .; then
        cat "$cache_dir/$1"
        return 0
    fi
    rm -f "$cache_dir/$1"
    return 1
}
cache_write() {
    printf "%s\n" "$2" >"$cache_dir/$1" 2>/dev/null
}

_cpe_key() {
    _ck=""
    for _ck_a in "$@"; do
        _ck="$_ck\t$_ck_a"
    done
    printf "%s" "$_ck" | cksum | cut -d " " -f 1
}

# Shared post-search steps: pick a show from the ready-made $anime_list, resolve
# the provider prefix ("all" mode), and choose the first episode if none given.
resolve_title() {
    [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
    [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Pick a title: ")
    [ -z "$result" ] && die "That pick didn't work out — try again!"
    anime_title="$(printf "%s" "$result" | cut -f 2)"
    anime_id="$(printf "%s" "$result" | cut -f 1)"
    if [ "$source" = "all" ]; then
        real_source="${anime_id%%:*}"
        anime_id="${anime_id#*:}"
        case "$real_source" in
            anidb|aniwatch|gogoanime|9anime|animeplanet|anisearch|youtube) source="$real_source" ;;
            *) die "Invalid provider in selection" ;;
        esac
    fi
}

resolve_episodes() {
    episode_maps="$(provider_episodes "$source" "$anime_id")" || exit 1
    ep_list="$(printf '%s' "$episode_maps" | cut -f 2)"
    [ -z "$ep_no" ] && ep_no=$(printf "%s" "$episode_maps" | nth "Pick an episode: " "$menu_multi_flag" | cut -f 1)
    [ -z "$ep_no" ] && die "Couldn't find that episode, sorry!"
}

# --lucky-tomato: shuffle the trending list and stop at the first show that
# actually has a playable stream.
pick_lucky_show() {
    _lucky_cands="$(aniwatch_trending)" || exit 1
    [ -z "$_lucky_cands" ] && die "The vine's bare right now — try again in a bit :3"
    _lucky_file="$(mktemp)" || return 1
    printf "%s\n" "$_lucky_cands" | sort -R | head -n 12 >"$_lucky_file"
    while IFS= read -r _lucky_line <&3; do
        [ -z "$_lucky_line" ] && continue
        source=aniwatch
        anime_id="$(printf "%s" "$_lucky_line" | cut -f 1)"
        anime_title="$(printf "%s" "$_lucky_line" | cut -f 2)"
        episode_maps="$(provider_episodes aniwatch "$anime_id" 2>/dev/null)"
        ep_no="$(printf '%s\n' "$episode_maps" | cut -f 1 | head -n 1)"
        if [ -n "$ep_no" ] && provider_m3u8 aniwatch "$anime_id" "$ep_no" sub 2>/dev/null | _probe_playable; then
            ep_list="$(printf '%s' "$episode_maps" | cut -f 2)"
            rm -f "$_lucky_file"
            info "Plucked a ripe one off the vine: $anime_title :3"
            return 0
        fi
    done 3<"$_lucky_file"
    rm -f "$_lucky_file"
    die "Everything on the vine's unripe today — try again later :3"
}

# Bare interactive `tp`: offer a menu instead of dropping straight into the
# search prompt. Plain numbered list so the mascot banner stays visible above
# it (a full-screen picker would cover it).
home_menu() {
    while :; do
        printf "\n    \033[1;32mWhat'll it be? :3\033[0m\n"
        printf "      1) Search for an anime\n"
        printf "      2) Continue watching\n"
        printf "      3) View watch history\n"
        printf "      4) See what's Hot on the Vine\n"
        printf "      5) Lucky Tomato (surprise me!)\n"
        printf "      q) Quit\n"
        printf "\n    Choice [1-5/q]: "
        read -r _home_choice
        case "$_home_choice" in
            1|s|search)
                source="${TOMATOPLAY_DEFAULT_SOURCE:-all}"
                break ;;
            2|c|continue)
                source=history
                break ;;
            3|h|history)
                history_view
                exit 0
                ;;
            4|t|trending)
                source=trending
                break ;;
            5|l|lucky)
                source=lucky
                break ;;
            q|Q|e|quit|exit)
                exit 0
                ;;
            *)
                printf "\033[1;31m    Not a valid pick, try again :3\033[0m\n" ;;
        esac
    done
}

# Drop search entries whose episode list is empty (they would only ever fail at
# the episode selection step). In "all" mode entries are prefixed with
# "provider:", so derive each entry's provider and id from that prefix.
filter_entries() {
    _fdir="$(mktemp -d)" || return 1
    _jobs=0
    while IFS= read -r _check_line; do
        [ -z "$_check_line" ] && continue
        _check_rid="$(printf '%s\n' "$_check_line" | cut -f 1)"
        _check_p="${_check_rid%%:*}"
        case "$_check_p" in
            anidb|aniwatch|gogoanime|9anime|animeplanet|anisearch|youtube)
                _check_source="$_check_p"
                _check_id="${_check_rid#*:}" ;;
            *) _check_source="$source" _check_id="$_check_rid" ;;
        esac
        _jobs=$((_jobs + 1))
        {
            _venice="$(provider_episodes "$_check_source" "$_check_id" 2>/dev/null)"
            _vfirst="$(printf '%s\n' "$_venice" | cut -f 1 | head -n 1)"
            if [ -n "$_vfirst" ] && {
                provider_m3u8 "$_check_source" "$_check_id" "$_vfirst" sub 2>/dev/null | _probe_playable ||
                provider_m3u8 "$_check_source" "$_check_id" "$_vfirst" dub 2>/dev/null | _probe_playable
            }; then
                printf "%s\n" "$_check_line"
            fi
        } 2>/dev/null >"$_fdir/$_jobs" &
        if [ "$_jobs" -ge "5" ]; then
            wait
            for _f in "$_fdir"/*; do [ -f "$_f" ] && cat "$_f"; done
            _jobs=0
            rm -f "$_fdir"/*
        fi
    done
    wait
    for _f in "$_fdir"/*; do [ -f "$_f" ] && cat "$_f"; done
    rm -rf "$_fdir"
}

# True if a provider_m3u8 result is an actual stream, not a broken page-URL
# fallback (which mpv can't play). Keeps aniwatch's vidnest HLS and any other
# real CDN/player link; drops anything pointing back at a scraper site.
_probe_playable() {
    while IFS= read -r _vline; do
        _vlink="${_vline#*>}"
        case "$_vlink" in
            "") continue ;;
            http*) ;;
            *) continue ;;
        esac
        _valid="1"
        for _vbase in "$aniwatch_base" "$gogoanime_base" "$nineanime_base" "$anidb_base" "$animeplanet_base" "$anisearch_base"; do
            [ -n "$_vbase" ] || continue
            case "$_vlink" in
                "${_vbase}"*) _valid="" ;;
            esac
        done
        [ -z "$_valid" ] || return 0
    done
    return 1
}

provider_m3u8() {
    _key="$(_cpe_key "m3u8" "$1" "$2" "${3:-?}" "${4:-sub}")"
    if cache_read "$_key" 30; then
        return 0
    fi
    case "$1" in
        anidb) _m3u8_out="$(anidb_m3u8 "$2" "$3" "${4:-sub}" 2>/dev/null)" ;;
        aniwatch) _m3u8_out="$(aniwatch_m3u8 "$2" "$3" "${4:-sub}" 2>/dev/null)" ;;
        gogoanime) _m3u8_out="$(gogoanime_m3u8 "$2" "$3" 2>/dev/null)" ;;
        9anime) _m3u8_out="$(nineanime_m3u8 "$2" "$3" 2>/dev/null)" ;;
        animeplanet) _m3u8_out="$(animeplanet_m3u8 "$2" "$3" 2>/dev/null)" ;;
        anisearch) _m3u8_out="$(anisearch_m3u8 "$2" "$3" 2>/dev/null)" ;;
        youtube) _m3u8_out="$(youtube_m3u8 "$2" "$3" 2>/dev/null)" ;;
        *) die "Unknown provider: $1" ;;
    esac
    [ -z "$_m3u8_out" ] && return 1
    cache_write "$_key" "$_m3u8_out"
    printf "%s\n" "$_m3u8_out"
}

# ============================================================================
# Quality Selection
# ============================================================================

select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && warn "$1 not found, defaulting to best" && _result=$(printf "%s" "$links" | head -n 1)
    video_link=$(printf "%s" "$_result" | cut -d ">" -f 2)
}

get_video_link() {
    links=$(provider_m3u8 "$source" "$anime_id" "$ep_no" "$mode" | sort -g -r -s)
    [ -z "$links" ] && die "No streams available for that one right now :("
    info "We found some streams on $source :3"
    select_quality "$quality"
    [ -z "$video_link" ] && die "Couldn't grab a stream link, sorry! :/"
}

# ============================================================================
# History Functions
# ============================================================================

process_hist_entry() {
    source=aniwatch
    ep_list=$(provider_episodes "$source" "$anime_id" | cut -f 2)
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$anime_id" "$anime_title" "$ep_no"
}

update_history() {
    if grep -q "	${anime_id}	" "$histfile"; then
        safe_title=$(printf "%s" "$anime_title" | sed 's|[&\|]|\\&|g')
        sed -E "s|^[^	]+	${anime_id}	[^	]+$|${ep_no}	${anime_id}	${safe_title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

history_view() {
    if [ ! -f "$histfile" ] || [ ! -s "$histfile" ]; then
        info "Nothing here yet :\ Go watch something and it'll show up! :3"
        return 0
    fi
    awk -F '\t' '{ n++; printf "%d. %s (episode %s)\n", n, $3, $1 }' "$histfile"
}

# ============================================================================
# Playback Functions
# ============================================================================

download() {
    command -v "yt-dlp" >/dev/null && yt-dlp "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4" $3 && return 0
    ffmpeg -extension_picky 0 -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4" $3
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t tomatoplay "${anime_title} ${ep_no}"
    [ -z "$video_link" ] && get_video_link
    wait
    _hls_flags=""
    case "$video_link" in
        *[mM]3[uU]8*) _hls_flags="--demuxer=lavf --demuxer-lavf-format=hls" ;;
    esac
    case "$player_function" in
        debug) printf "All links:\n%s\nSelected link:\n%s\n" "$links" "$video_link" ;;
        android_mpv) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n is.xyz.mpv/.MPVActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *flatpak*mpv*) flatpak run io.mpv.Mpv $player_extra_flags $_hls_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $player_extra_flags $_hls_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                $player_function $player_extra_flags $_hls_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$_range" ] && exit "$mpv_exitcode"
            fi
            ;;
        *iina*)
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function $player_extra_flags --no-stdin --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                nohup $player_function $player_extra_flags --no-stdin --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            fi
            ;;
        *vlc*) nohup $player_function $player_extra_flags --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        download) "$player_function" "$video_link" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        *) nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
    esac
    replay="$video_link"
    unset video_link
    update_history
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    _start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    _end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$_start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n 1) && unset _start
    [ -z "$_end" ] || [ "$_end" = "$_start" ] && unset _start _end
    [ "$_start" = "0" ] && _start=$(printf "%s" "$ep_list" | head -n 1)
    [ "$_end" = "-1" ] && _end=$(printf "%s" "$ep_list" | tail -n 1)
    _line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$_line_count" != 1 ] || [ -n "$_start" ]; then
        [ -z "$_start" ] && _start=$(printf "%s\n" "$ep_no" | head -n 1)
        [ -z "$_end" ] && _end=$(printf "%s\n" "$ep_no" | tail -n 1)
        _range=$(printf "%s\n" "$ep_list" | sed -nE "/^${_start}\$/,/^${_end}\$/p")
        [ -z "$_range" ] && die "Invalid range!"
        for i in $_range; do
            tput clear
            ep_no=$i
            info "Booting up episode $ep_no — enjoy your show! :3"
            [ "$i" = "$_end" ] && unset _range
            play_episode
        done
    else
        printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid episode!"
        play_episode
    fi
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput cuu1 && tput el
    tput sc
}

# ============================================================================
# Setup
# ============================================================================

ciphers='ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'
tls13_ciphers='TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256'
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

mode="${TOMATOPLAY_MODE:-sub}"
if [ -n "$TOMATOPLAY_MODE" ]; then mode_set=1; else mode_set=0; fi
case "$mode" in dub) mode="dub" ;; *) mode="sub" ;; esac
download_dir="${TOMATOPLAY_DOWNLOAD_DIR:-.}"
log_episode="${TOMATOPLAY_LOG:-1}"
quality="${TOMATOPLAY_QUALITY:-best}"
source="${TOMATOPLAY_DEFAULT_SOURCE:-all}"

curl_exe=$(dep_ch_failover "curl_firefox135,curl_chrome136,curl_chrome116,curl_ff117,curl") || die "Program curl not found"

case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*)
        cipher_flag="--ciphers $ciphers --tls13-ciphers $tls13_ciphers"
        player_function="${TOMATOPLAY_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}" || die 'No player found'
        ;;
    *ndroid*) player_function="${TOMATOPLAY_PLAYER:-android_mpv}" ;;
    *MINGW* | *WSL2*) player_function="${TOMATOPLAY_PLAYER:-mpv.exe}" ;;
    *) player_function="${TOMATOPLAY_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}" || die 'No player found' ;;
esac

player_extra_flags="${TOMATOPLAY_PLAYER_FLAGS:-""}"
no_detach="${TOMATOPLAY_NO_DETACH:-0}"
exit_after_play="${TOMATOPLAY_EXIT_AFTER_PLAY:-0}"
menu_program="${TOMATOPLAY_MENU:-fzf}"
menu_extra_flags="${TOMATOPLAY_MENU_FLAGS:-""}"
branch="${TOMATOPLAY_BRANCH:-main}"

if [ ! -t 0 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi

hist_dir="${TOMATOPLAY_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tomato-play}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/tp-hsts"
[ ! -f "$histfile" ] && : >"$histfile"

cache_init

# ============================================================================
# Argument Parsing
# ============================================================================

query=""
while [ $# -gt 0 ]; do
    case "$1" in
        -s | --source)
            [ $# -lt 2 ] && die "missing argument!"
            source="$2"
            shift
            ;;
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) source=history ;;
        -T | --trending) source=trending ;;
        -L | --lucky-tomato) source=lucky ;;
        -d | --download)
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -H | --history)
            history_view
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t tomatoplay ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        -a | --audio)
            [ $# -lt 2 ] && die "missing argument!"
            case "$2" in dub) mode="dub" ;; *) mode="sub" ;; esac
            mode_set=1
            shift
            ;;
        --dub) mode="dub"; mode_set=1 ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        -U | --update)
            dep_ch "patch"
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

# ============================================================================
# Dependency Check
# ============================================================================

trap 'cleanup; exit 1' INT HUP TERM

# Bare interactive invocations get a home menu instead of the raw search
# prompt, with the mascot banner and tagline shown right above it.
if [ -t 0 ] && [ -t 1 ] && [ -z "$query" ] &&
   ! printf "%s" "$source" | grep -qxE 'history|trending|lucky'; then
    banner
    home_menu
else
    [ -t 1 ] && banner
fi

info "Checking dependencies, one sec :3"
dep_ch "sed"
dep_ch "grep"
dep_ch "$menu_program"

case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *flatpak*mpv*) dep_ch "flatpak" ;;
    *) dep_ch "$player_function" ;;
esac

# ============================================================================
# Main Logic
# ============================================================================

case "$source" in
    history)
        anime_list=$(while read -r ep_no anime_id anime_title; do process_hist_entry & done <"$histfile")
        wait
        [ -z "$anime_list" ] && die "You're all caught up! Nothing unwatched in your history, time to pick another show?"
        source=aniwatch
        resolve_title
        anime_title="$(printf "%s" "$anime_title" | sed 's| - episode.*||')"
        ep_no=$(printf "%s" "$anime_list" | grep "^$anime_id	" | sed -nE 's/.*- episode (.+)$/\1/p')
        resolve_episodes
        ;;
    trending)
        anime_list="$(aniwatch_trending)"
        [ -z "$anime_list" ] && die "The vine's bare right now — try again in a bit :3"
        source=aniwatch
        anime_list="$(printf "%s\n" "$anime_list" | filter_entries)"
        [ -z "$anime_list" ] && die "No playable picks on the vine right now :3"
        resolve_title
        resolve_episodes
        ;;
    lucky)
        pick_lucky_show
        ;;
    *)
        if [ "$menu_program" = "fzf" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(: | menu "Search: " "" "$menu_extra_flags")
            [ -z "$query" ] && exit 1
        fi

        query=$(printf "%s" "$query" | tr -s ' ')

        anime_list=$(fuzzy_search "$source" "$query") || exit 1
        [ -z "$anime_list" ] && die "Hmm, nothing found for that — double-check the spelling maybe? :3"
        # Only offer series that actually have an episode list (anything else
        # would fail later with an invalid episode selection).
        anime_list=$(printf "%s\n" "$anime_list" | filter_entries)
        [ -z "$anime_list" ] && die "Hmm, nothing found for that — double-check the spelling maybe? :3"
        resolve_title
        resolve_episodes
        ;;
esac

# If the series has an English dub, let the user pick the audio track.
if [ "$source" = "aniwatch" ] && [ "$mode_set" = "0" ] && [ -t 1 ]; then
    if printf "%s" "$ep_no" | grep -qE '^[0-9]+$'; then
        _modes="$(aniwatch_modes "$anime_id" "$ep_no" 2>/dev/null || true)"
        if printf "%s" "$_modes" | grep -qx "dub"; then
            _audio_menu=""
            printf "%s" "$_modes" | grep -qx "sub" && _audio_menu="${_audio_menu}sub\\tSubtitled (Japanese)\\n"
            _audio_menu="${_audio_menu}dub\\tEnglish Dub\\n"
            _audio_choice="$(printf "%b" "$_audio_menu" | menu "Audio: " "" "$menu_extra_flags")"
            case "$_audio_choice" in
                *dub*) mode="dub" ;;
                *) mode="sub" ;;
            esac
            info "Audio: $mode"
            mode_set=1
        fi
    fi
fi

tput cuu1 && tput el
tput sc

play
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

while cmd=$(printf "next\nreplay\nprevious\nselect\nchange_audio\nchange_quality\nquit" | nth "Now showing episode $ep_no of $anime_title — enjoy! :3 ... "); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) video_link="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$episode_maps" | nth "Pick an episode: " "$menu_multi_flag" | cut -f 1) ;;
        change_audio)
            case "$mode" in dub) mode="sub" ;; *) mode="dub" ;; esac
            info "Audio: $mode"
            video_link=""
            ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu "Select Quality: " "" "$menu_extra_flags" | cut -d ">" -f 1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

